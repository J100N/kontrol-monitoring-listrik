# =========================
# EMQX
# =========================
EMQX_VERSION=5.8.3
EMQX_MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=change_this_password

# =========================
# InfluxDB 2.x
# =========================
INFLUXDB_VERSION=2.7
INFLUXDB_PORT=8086
INFLUXDB_ADMIN_USERNAME=admin
INFLUXDB_ADMIN_PASSWORD=change_this_password
INFLUXDB_ORG=ta_org
INFLUXDB_BUCKET=telemetry
INFLUXDB_ADMIN_TOKEN=replace_with_secure_long_token

# Source code worker yang di-mount ke container /app.
# Jika docker-compose.yml diletakkan di root server (mis. /opt/iot-listrik),
# gunakan ./backend/mqtt_worker.
MQTT_WORKER_SRC=../../backend/mqtt_worker
