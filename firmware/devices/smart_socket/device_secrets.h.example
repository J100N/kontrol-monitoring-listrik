#ifndef DEVICE_SECRETS_H
#define DEVICE_SECRETS_H

// =============================================================================
//  TEMPLATE. Salin file ini menjadi `device_secrets.h`, lalu isi nilai aslinya.
//  `device_secrets.h` diblokir .gitignore supaya kredensial tidak ikut ter-commit.
// =============================================================================

// Kredensial Wi-Fi.
#define WIFI_STA_SSID "nama_wifi"
#define WIFI_STA_PASSWORD "password_wifi"

// Alamat & kredensial broker MQTT (EMQX) per-device.
#define MQTT_BROKER_HOST "alamat_broker"
#define MQTT_USERNAME "dev_socket_01"
#define MQTT_PASSWORD "password_mqtt"

// Kunci simetris ASCON-128 (16 byte). Harus sama dengan entri ASCON_KEYRING_JSON
// di backend/mqtt_worker/.env untuk key id yang sama.
// Bangkitkan kunci acak, jangan pakai pola berurutan.
#define ASCON_KEY_ID 1U
#define ASCON_KEY_BYTES \
	{               \
		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00  \
	}

#endif
